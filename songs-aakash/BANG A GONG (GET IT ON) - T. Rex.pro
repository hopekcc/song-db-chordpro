{ns}
{define: EC# base-fret 1 frets 0 2 2 1 2 0} 
{define: G- base-fret 1 frets 3 2 0 0 0 0} 
{define: EC#m base-fret 1 frets 0 4 2 1 0 0}
{define: A6G# base-fret 1 frets x x 2 2 2 4}
{t: BANG A GONG (GET IT ON) - T. Rex}
